#-----------------------------------------------------------------------------
# HRGZDevEngine DOOM - Xbox 360 Makefile
# Targets:
#   - xenon.elf  : XeLL Eject Boot ELF for Xbox 360 Peer Pressure Softmod
#   - default.xex: Unsigned Dashboard XEX for Aurora / XeXMenu / Softmod Launcher
#-----------------------------------------------------------------------------

CROSS_COMPILE ?= xenon-
CC            := $(CROSS_COMPILE)gcc
CXX           := $(CROSS_COMPILE)g++
OBJCOPY       := $(CROSS_COMPILE)objcopy
STRIP         := $(CROSS_COMPILE)strip
ELF2XEX       ?= xenon-elf2xex

DEVKITXENON   ?= /usr/local/xenon

CFLAGS  := -O3 -mcpu=cell -mtune=cell -m32 -fno-builtin -Wall \
           -Wno-parentheses -Wno-unused-variable -Wno-unused-const-variable \
           -std=c99 -DLIBXENON -D__BIG_ENDIAN__ \
           -I../../doom -I../common -I$(DEVKITXENON)/usr/include

LDFLAGS := -L$(DEVKITXENON)/usr/lib -lxenon -lm -lc

DOOM_SRCS := $(wildcard ../../doom/*.c)
COMMON_SRCS := ../common/i_gamepad.c ../common/i_sound_mixer.c ../common/i_net_ip.c
XENON_SRCS := i_video_xenon.c i_sound_xenon.c i_system_xenon.c i_net_xenon.c i_main_xenon.c

ALL_SRCS := $(DOOM_SRCS) $(COMMON_SRCS) $(XENON_SRCS)
ALL_OBJS := $(ALL_SRCS:.c=.o)

TARGET_ELF := xenon.elf
TARGET_XEX := default.xex

.PHONY: all clean xex

all: $(TARGET_ELF)

$(TARGET_ELF): $(ALL_OBJS)
	@echo "Linking Xbox 360 Bare-Metal Executable: $@"
	$(CC) $(CFLAGS) -o $@ $(ALL_OBJS) $(LDFLAGS)
	$(STRIP) $@

xex: $(TARGET_ELF)
	@echo "Packaging Unsigned Peer Pressure Dashboard Executable: $(TARGET_XEX)"
	$(ELF2XEX) -o $(TARGET_XEX) $(TARGET_ELF)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(TARGET_ELF) $(TARGET_XEX) $(ALL_OBJS)

