{
  "name": "hrgzdevengine",
  "version": "1.0.0",
  "description": "All-in-One Game Creation, Compilation & Distribution System based on DOOM",
  "bin": {
    "hrgz": "./bin/hrgz"
  },
  "scripts": {
    "studio": "node studio/server.js",
    "init": "node bin/hrgz init",
    "inspect": "node bin/hrgz inspect",
    "build": "node bin/hrgz build",
    "dist": "node bin/hrgz dist",
    "run": "node bin/hrgz run",
    "package:studio": "node studio/package_studio.js all",
    "package:mac": "node studio/package_studio.js mac",
    "package:linux": "node studio/package_studio.js linux",
    "package:win": "node studio/package_studio.js win",
    "test": "./build/test/doom_test -iwad doom1.wad -warp 1 1 -testframes 50"
  },
  "keywords": [
    "doom",
    "game-engine",
    "game-distribution",
    "game-studio",
    "retro-fps"
  ],
  "author": "HRGZDevEngine Team",
  "license": "GPL-2.0"
}

